{
    "name": "sunnysideup/versions-table-pruner",
    "description": "prune your Versions table, keeping many, but the further you go back in time, the less versions you keep. You can also keep versions were a specific field was changed (e.g. Content, Price, or Title)",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "prune",
        "versions",
        "version",
        "database maintenance",
        "db",
        "spring clean",
        "reduce rows",
        "database size",
        "historic",
        "truncate",
        "delete"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "silverstripe/framework": "^6.0",
        "silverstripe/admin": "^3.0"
    },
    "require-dev": {
        "sunnysideup/sswebpack_engine_only": "^5.0-dev",
        "silverleague/ideannotator": "*",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.7",
        "silverstripe/standards": "^1",
        "phpstan/extension-installer": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Sunnysideup\\VersionsTablePruner\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Nicolaas Thiemen Francken",
            "email": "modules@sunnysideup.co.nz",
            "role": "lead developer"
        }
    ]
}
